      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "Testes",
      "type": "npm",
      "script": "test",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Compilar para produção",
      "type": "npm",
      "script": "build",
      "problemMatcher": ["$tsc"],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
