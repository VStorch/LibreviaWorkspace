<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Librevia.Format</AssemblyName>
    <RootNamespace>Librevia.Format</RootNamespace>

    <!-- Avisos são erros: o sidecar roda sem ninguém olhando o console dele. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Nunca falamos com a rede, e não queremos telemetria saindo da máquina. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>

    <!-- Alvos decididos em §8.1 do plano. -->
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Trimming desligado de propósito: OpenXml e ClosedXML usam reflexão, e
         um trim agressivo quebraria a leitura de partes só em tempo de execução,
         que é o pior momento possível para descobrir. Tamanho é problema da
         Fase 8; corretude é problema de agora. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Compilação antecipada, ligada por medição e não por hábito. Numa
         planilha de 120 mil células, abrindo três vezes seguidas no mesmo
         processo:

           sem R2R:  3821 ms → 1188 ms → 779 ms   (85 MB)
           com R2R:  1925 ms → 1604 ms → 894 ms  (126 MB)

         Ou seja: R2R corta a **primeira** abertura pela metade e perde ~100 ms
         no regime permanente, porque o código pré-compilado é menos otimizado
         que o que o JIT produz depois de aquecer. A primeira é a que o usuário
         sente como travamento; a diferença no regime permanente ninguém
         percebe. Os 41 MB a mais por plataforma são o preço, e numa
         distribuição interna por rede local eles cabem. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

</Project>
