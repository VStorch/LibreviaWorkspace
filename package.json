{
  "name": "librevia",
  "version": "0.0.0",
  "description": "Suíte de documentos e planilhas para desktop — offline, DOCX/XLSX/PDF",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sidecar:build": "node scripts/sidecar.mjs build",
    "sidecar:build:all": "node scripts/sidecar.mjs build --all",
    "sidecar:test": "dotnet test sidecar/Librevia.Format.slnx --nologo",
    "sidecar:licenses": "node scripts/sidecar.mjs licenses",
    "licenses:check": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow \"MIT;MIT-0;ISC;0BSD;BSD-2-Clause;BSD-3-Clause;Apache-2.0;CC0-1.0;CC-BY-4.0;Unlicense;Python-2.0;BlueOak-1.0.0\"",
    "licenses:report": "license-checker-rseidelsohn --production --excludePrivatePackages --csv --out THIRD-PARTY-NOTICES.csv",
    "verify": "npm run typecheck && npm run lint && npm run sidecar:test && npm run sidecar:build && npm run test && npm run licenses:check && npm run sidecar:licenses"
  },
  "dependencies": {
    "@tiptap/core": "^3.30.0",
    "@tiptap/extension-color": "^3.30.0",
    "@tiptap/extension-font-family": "^3.30.0",
    "@tiptap/extension-highlight": "^3.30.0",
    "@tiptap/extension-image": "^3.30.0",
    "@tiptap/extension-table": "^3.30.0",
    "@tiptap/extension-text-align": "^3.30.0",
    "@tiptap/extension-text-style": "^3.30.0",
    "@tiptap/pm": "^3.30.0",
    "@tiptap/react": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "electron-store": "^11.0.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
